# Postgres connection string. Local dev uses docker-compose.yml (port 5433).
DATABASE_URI=postgresql://alveo:alveo@localhost:5433/alveo
# Long random string. Generate one per environment; never reuse the dev value.
PAYLOAD_SECRET=
# Public origin of the site, no trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Directory for Payload uploads. Mount a persistent volume here in production.
PAYLOAD_MEDIA_DIR=./media
# Used once by `pnpm seed` to create the first admin if no user exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional Cloudflare Turnstile on the inquiry form, read at runtime. Leave both empty to turn it off.
# Setting only one of them makes the form refuse submissions.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
